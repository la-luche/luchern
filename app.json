{
  "expo": {
    "name": "Luche",
    "slug": "luche-rn",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/luche-app-icon.png",
    "scheme": "luche",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/luche-app-icon.png",
      "bundleIdentifier": "ai.getferal.luche",
      "appleTeamId": "CVR9PS8CQG",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDisplayName": "Luche",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "40"
    },
    "android": {
      "package": "ai.getferal.luche",
      "allowBackup": false,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "versionCode": 40
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000C27",
          "image": "./assets/images/luche-splash-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Luche uses the camera to record short movement tests for research and wellness and to create experimental estimates.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "./plugins/with-ios26-touch-fix",
      "./plugins/with-async-storage-capacity",
      [
        "expo-build-properties",
        {
          "android": {
            "useLegacyPackaging": true
          }
        }
      ],
      "./plugins/with-android-lean-apk",
      "./plugins/with-background-work",
      "./plugins/with-network-recovery",
      "./plugins/with-build-version"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cf2e8b60-4dd8-4730-b1bc-80b3d55418a4"
      }
    },
    "owner": "sposiboh"
  }
}
