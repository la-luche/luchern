index 0000000..6476331
--- /dev/null
+++ b/node_modules/expo-video/ios/LuchePlaybackError.swift
@@ -0,0 +1,20 @@
+import Foundation
+
+// Preserve an underlying URL transport error when AVFoundation wraps it.
+// JS can then await connection recovery before replacing the player. HTTP,
+// certificate, cancellation and decoding errors keep their original meaning.
+func luchePlaybackErrorDescription(_ error: Error?) -> String? {
+  guard let error else { return nil }
+  var current: NSError? = error as NSError
+  let codes = [NSURLErrorTimedOut, NSURLErrorCannotFindHost,
+               NSURLErrorCannotConnectToHost, NSURLErrorNetworkConnectionLost,
+               NSURLErrorDNSLookupFailed]
+  for _ in 0..<8 {
+    guard let item = current else { break }
+    if item.domain == NSURLErrorDomain && codes.contains(item.code) {
+      return "Network connection failed (\(item.code)): \(error.localizedDescription)"
+    }
+    current = item.userInfo[NSUnderlyingErrorKey] as? NSError
+  }
+  return error.localizedDescription
+}
